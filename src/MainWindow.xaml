<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VarPad" Width="580" Height="570" MinWidth="400" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" Foreground="#9DE8AA">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#9DE8AA"/>
    <SolidColorBrush x:Key="Muted" Color="#8D9C91"/>
    <SolidColorBrush x:Key="Line" Color="#354039"/>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Thumb">
          <Border x:Name="Grip" Background="{DynamicResource Muted}" Opacity="0.4" CornerRadius="3"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
          </Track>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              <Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/>
              <Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#243C5941"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#354C7054"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#50537257"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#252B27"/>
      <Setter Property="Foreground" Value="#D3E8D7"/>
      <Setter Property="BorderBrush" Value="#4C6051"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
  </Window.Resources>
  <Border x:Name="Shell" CornerRadius="10" BorderBrush="#526258" BorderThickness="1" Background="#F0252927">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="26"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="36"/>
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" CornerRadius="10,10,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <Grid Margin="8,0,5,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="18" Height="18" CornerRadius="4" Background="#254A32" Margin="0,0,6,0">
              <TextBlock Text="=" Foreground="#B0F4BA" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
            </Border>
            <TextBlock Text="Var" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="Pad" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="New" Content="+" ToolTip="New note (Ctrl+N)" AutomationProperties.Name="New note" Width="24" Padding="3,3" FontSize="16"/>
            <Button x:Name="Notes" Content="Notes" ToolTip="Open saved notes" Width="40" Padding="3,3" FontSize="11"/>
            <Button x:Name="Angle" Content="DEG" ToolTip="Toggle degrees / radians" Width="34" Padding="3,3" FontSize="11" FontFamily="Consolas"/>
            <Button x:Name="Settings" Content="&#x22EF;" ToolTip="Settings" AutomationProperties.Name="Settings" Width="28" Padding="3,3" FontSize="16"/>
            <Button x:Name="Help" Content="?" ToolTip="Functions and shortcuts (F1)" AutomationProperties.Name="Help" Width="24" Padding="3,3" FontSize="11"/>
            <Button x:Name="Pin" Content="Pin" ToolTip="Keep this note on top (Ctrl+Shift+P)" Width="46" Padding="3,3" FontSize="11"/>
            <Button x:Name="Minimize" Content="&#x2013;" FontSize="14" ToolTip="Minimize" Width="26" Padding="3,3"/>
            <Button x:Name="Close" Content="&#x00D7;" FontSize="16" ToolTip="Close window · note stays saved" Width="26" Padding="3,3"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="14,2,14,2">
        <TextBox x:Name="NoteTitle" Text="Scratchpad" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}" FontSize="11" FontWeight="SemiBold" VerticalContentAlignment="Center" MaxLength="80" ToolTip="Rename this note" Padding="0"/>
      </Grid>
      <Grid Grid.Row="2" x:Name="WritingArea" Margin="0,0,8,0" ClipToBounds="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="41"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Canvas x:Name="Numbers" ClipToBounds="True" IsHitTestVisible="False"/>
        <TextBox x:Name="Editor" Grid.Column="1" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" Background="Transparent" BorderThickness="0" Padding="0,4,10,20" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SelectionBrush="#476D50" SelectionOpacity="0.7" SpellCheck.IsEnabled="False" UndoLimit="200">
          <TextBox.Template><ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource SlimScrollViewer}"/>
          </ControlTemplate></TextBox.Template>
        </TextBox>
        <Canvas x:Name="Results" Grid.Column="1" ClipToBounds="True"/>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="12,0,12,0">
        <DockPanel Margin="7,0,7,0" LastChildFill="True">
          <Button x:Name="Variables" Content="0 variables" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}" Padding="6,5"/>
          <TextBlock x:Name="Status" Text="Saved on this device" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
